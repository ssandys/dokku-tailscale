#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"
source "$PLUGIN_CORE_AVAILABLE_PATH/config/functions"
source "$PLUGIN_CORE_AVAILABLE_PATH/ps/functions"

tailscale_authkey_dir() {
  echo "${DOKKU_LIB_ROOT}/data/tailscale"
}

tailscale_authkey_file() {
  echo "$(tailscale_authkey_dir)/.authkey"
}

# Anything that touches the auth key runs with xtrace off, so DOKKU_TRACE
# never writes the key to build logs or journald. Usage:
#   local xtrace; xtrace="$(tailscale_xtrace_state)"; set +x
#   ...
#   tailscale_xtrace_restore "$xtrace"
tailscale_xtrace_state() {
  if [[ $- == *x* ]]; then echo "on"; else echo "off"; fi
}

tailscale_xtrace_restore() {
  if [[ "$1" == "on" ]]; then set -x; fi
}

tailscale_global_authkey() {
  # config_get may fail on some Dokku versions when the key is unset; treat
  # that as "not set" rather than relying on $(...) ignoring errexit.
  local key
  key="$(config_get --global TS_AUTHKEY)" || true
  echo "$key"
}

tailscale_authkey_source() {
  # Prints one of: unreadable, file, global, none
  local key_file
  key_file="$(tailscale_authkey_file)"
  if [[ -e "$key_file" && ! -r "$key_file" ]]; then
    echo "unreadable"
  elif [[ -s "$key_file" ]]; then
    echo "file"
  elif [[ -n "$(tailscale_global_authkey)" ]]; then
    echo "global"
  else
    echo "none"
  fi
}

tailscale_authkey_missing_message() {
  echo "No Tailscale auth key set. Store one with: dokku tailscale:set-key < key.txt"
}

tailscale_authkey_unreadable_message() {
  echo "the key file exists but the dokku user can't read it: $(tailscale_authkey_file) (fix with: chown dokku:dokku <file>; chmod 600 <file>)"
}

tailscale_authkey_global_warning() {
  echo "TS_AUTHKEY is read from global config, which is visible to every app; run tailscale:set-key, then dokku config:unset --global TS_AUTHKEY"
}

tailscale_authkey_leftover_warning() {
  echo "global TS_AUTHKEY is still set and visible to every app: run dokku config:unset --global TS_AUTHKEY, then dokku ps:rebuild --all"
}

tailscale_authkey() {
  # Print the auth key on stdout (callers capture it). The key file wins; the
  # global config is a deprecated fallback because Dokku injects global config
  # into every app container's environment. Warnings go to stderr explicitly,
  # since stdout is captured as the key.
  local xtrace
  xtrace="$(tailscale_xtrace_state)"
  set +x

  local key_file global_key key
  key_file="$(tailscale_authkey_file)"
  global_key="$(tailscale_global_authkey)"

  case "$(tailscale_authkey_source)" in
    unreadable)
      dokku_log_fail "$(tailscale_authkey_unreadable_message)"
      ;;
    file)
      key="$(<"$key_file")"
      [[ -n "$global_key" ]] && dokku_log_warn "$(tailscale_authkey_leftover_warning)" >&2
      echo "$key"
      ;;
    global)
      dokku_log_warn "$(tailscale_authkey_global_warning)" >&2
      echo "$global_key"
      ;;
  esac

  tailscale_xtrace_restore "$xtrace"
}

tailscale_set_key() {
  local key_dir key_file key tmp_file login_server

  key_dir="$(tailscale_authkey_dir)"
  key_file="$(tailscale_authkey_file)"
  login_server="$(config_get --global TS_LOGIN_SERVER)" || true

  if [[ -t 0 ]]; then
    read -r -s -p "Tailscale auth key: " key || true
    echo >&2
  else
    key="$(cat)"
  fi

  # trim surrounding whitespace (including newlines)
  key="${key#"${key%%[![:space:]]*}"}"
  key="${key%"${key##*[![:space:]]}"}"

  [[ -z "$key" ]] && dokku_log_fail "No key read from stdin. Usage: dokku tailscale:set-key < key.txt"
  [[ "$key" =~ [[:space:]] ]] && dokku_log_fail "The key must be a single line with no spaces; nothing was stored"
  # Tailscale keys start with tskey-. With a custom login server (Headscale),
  # any single token is accepted, since Headscale keys use other formats.
  if [[ -z "$login_server" && "$key" != tskey-* ]]; then
    dokku_log_fail "That does not look like a Tailscale auth key (expected it to start with tskey-; any key is accepted when TS_LOGIN_SERVER is set); nothing was stored"
  fi

  umask 077
  if [[ ! -d "$key_dir" ]]; then
    mkdir -p "$key_dir"
    [[ "$(id -u)" == "0" ]] && chown dokku:dokku "$key_dir"
  fi

  tmp_file="$(mktemp "${key_dir}/.authkey.XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -f '${tmp_file}'" EXIT
  printf '%s\n' "$key" >"$tmp_file"
  chmod 600 "$tmp_file"
  [[ "$(id -u)" == "0" ]] && chown dokku:dokku "$tmp_file"
  mv -f "$tmp_file" "$key_file"
  trap - EXIT

  dokku_log_info1 "Stored Tailscale auth key in ${key_file}"
  if [[ -n "$(tailscale_global_authkey)" ]]; then
    dokku_log_warn "TS_AUTHKEY is still set in global config and visible to every app. Remove it with: dokku config:unset --global TS_AUTHKEY, then dokku ps:rebuild --all"
    dokku_log_warn "Then revoke that key in the Tailscale admin console, since apps could read it"
  fi
}

tailscale_key_status() {
  case "$(tailscale_authkey_source)" in
    unreadable) tailscale_authkey_unreadable_message ;;
    file)
      if [[ -n "$(tailscale_global_authkey)" ]]; then
        echo "key file (WARNING: $(tailscale_authkey_leftover_warning))"
      else
        echo "key file"
      fi
      ;;
    global) echo "global config TS_AUTHKEY (deprecated: visible to every app — move it with tailscale:set-key, then dokku config:unset --global TS_AUTHKEY)" ;;
    *) echo "not set" ;;
  esac
}

tailscale_up() {
  [[ -z "$APP" ]] && dokku_log_fail "Please specify an app to run the command on"
  verify_app_name "$APP"

  # Check that a key is available, with xtrace off so the key isn't traced.
  local xtrace authkey
  xtrace="$(tailscale_xtrace_state)"
  set +x
  authkey="$(tailscale_authkey)" || exit 1
  [[ -z "$authkey" ]] && dokku_log_fail "$(tailscale_authkey_missing_message)"
  authkey=""
  tailscale_xtrace_restore "$xtrace"

  # Tailscale will join the app container's network, and will advertise its
  # name to the tailnet as the hostname of the app container. By default, the
  # hostname is the container ID. Set the hostname, instead, to the name of the
  # app, so that the machine in the tailnet is the same name as the app.
  #
  # Note that, if the app container is already running when tailscale:up is
  # called, then the containers need to be restarted in order to take on the
  # correct hostname. The container will still be put on the tailnet without a
  # restart, but with the wrong hostname.
  dokku_log_info1 "settings docker-option for ${APP} to --hostname=${APP}"
  # Use the public CLI: the docker-options shell library was removed from Dokku
  # core. Remove first so repeated `tailscale:up` calls don't stack duplicates.
  dokku docker-options:remove "$APP" deploy "--hostname ${APP}" >/dev/null 2>&1 || true
  dokku docker-options:add "$APP" deploy "--hostname ${APP}"

  # create state dir
  local storage_directory="${DOKKU_LIB_ROOT}/data/tailscale/${APP}"
  dokku_log_info1 "Ensuring ${storage_directory} exists"
  mkdir -p "${storage_directory}"

  touch "${storage_directory}/DOKKU_ENABLED"
}

tailscale_detach() {
  [[ -z "$APP" ]] && dokku_log_fail "No app specified"
  verify_app_name "$APP"

  ( ! tailscale_is_enabled ) && return

  container_id=$("$DOCKER_BIN" ps -qaf "name=ts-$APP")
  if [[ -n "$container_id" ]] ; then
    dokku_log_info1 "removing tailscale container ts-${APP}"
    "$DOCKER_BIN" container stop "${container_id}"
    "$DOCKER_BIN" container rm "${container_id}"
  fi
}

tailscale_down() {
  [[ -z "$APP" ]] && dokku_log_fail "No app specified"
  verify_app_name "$APP"

  ( ! tailscale_is_enabled ) && return
  tailscale_detach
  rm -f "${DOKKU_LIB_ROOT}/data/tailscale/${APP}/DOKKU_ENABLED"
  dokku docker-options:remove "$APP" deploy "--hostname ${APP}" >/dev/null 2>&1 || true
}

tailscale_is_enabled() {
  [[ -z "$APP" ]] && dokku_log_fail "No app specified"
  verify_app_name "$APP"
  [[ -f "${DOKKU_LIB_ROOT}/data/tailscale/${APP}/DOKKU_ENABLED" ]]
}

tailscale_attach() {
  [[ -z "$APP" ]] && dokku_log_fail "No app specified"
  verify_app_name "$APP"

  ( ! tailscale_is_enabled ) && return

  local login_arg="" login_server ts_extra_args
  login_server="$(config_get --global TS_LOGIN_SERVER)" || true
  [[ -n "${login_server}" ]] && login_arg="--login-server=${login_server}"

  ts_extra_args="$(config_get --global TS_EXTRA_ARGS)" || true

  local storage_directory="${DOKKU_LIB_ROOT}/data/tailscale/${APP}"

  # From here until the container is started, xtrace stays off so the key is
  # never written to deploy logs. The key reaches docker through the
  # environment (--env TS_AUTHKEY with no value), not the docker argv.
  local xtrace authkey status=0
  xtrace="$(tailscale_xtrace_state)"
  set +x
  authkey="$(tailscale_authkey)" || exit 1
  [[ -z "$authkey" ]] && dokku_log_fail "$(tailscale_authkey_missing_message)"

  dokku_log_info1 "starting tailscale container ts-${APP}"
  TS_AUTHKEY="${authkey}" "$DOCKER_BIN" container run \
    "--label=com.dokku.app-name=${APP}" \
    $DOKKU_GLOBAL_RUN_ARGS \
    --name "ts-${APP}" \
    --env TS_AUTHKEY \
    --env TS_EXTRA_ARGS="--advertise-tags=tag:dokku ${login_arg} ${ts_extra_args}" \
    --env TS_STATE_DIR=/var/lib/tailscale \
    --volume "${storage_directory}":/var/lib/tailscale \
    --volume /dev/net/tun:/dev/net/tun \
    --cap-add=NET_ADMIN \
    --cap-add=SYS_MODULE \
    --restart unless-stopped \
    --network "container:${APP}.web.1" \
    --detach \
    tailscale/tailscale:latest || status=$?
  authkey=""
  tailscale_xtrace_restore "$xtrace"
  return "$status"
}

tailscale_serve_start() {
  [[ -z "$APP" ]] && dokku_log_fail "Please specify an app to run the command on"
  verify_app_name "$APP"

  ( ! tailscale_is_enabled ) && dokku_log_fail "tailscale is not enabled for $APP"

  "$DOCKER_BIN" exec "ts-${APP}" tailscale serve --bg "$PORT"
  dokku_log_info1 "started serving traffic for ${APP} :${PORT} -> :443"
}

tailscale_serve_stop() {
  [[ -z "$APP" ]] && dokku_log_fail "Please specify an app to run the command on"
  verify_app_name "$APP"

  ( ! tailscale_is_enabled ) && dokku_log_fail "tailscale is not enabled for $APP"

  "$DOCKER_BIN" exec "ts-${APP}" tailscale serve --https=443 off
  dokku_log_info1 "stopped serving traffic for ${APP} on :443"
}

tailscale_is_running_for_app() {
  # If there's a tailscale container running for this app, return the name of
  # the tailscale container.
  #
  # Callers can use the output by checking if it's empty. An empty output means
  # that the container is not found.
  [[ -z "$APP" ]] && dokku_log_fail "Please specify an app to run the command on"
  verify_app_name "$APP"

  "$DOCKER_BIN" ps --filter "name=ts-${APP}" --format "{{.Names}}"
}

tailscale_serve_url() {
  [[ -z "$APP" ]] && dokku_log_fail "Please specify an app to run the command on"
  verify_app_name "$APP"

  ( ! tailscale_is_enabled ) && return

  output=$("$DOCKER_BIN" exec "ts-${APP}" tailscale serve status)
  if [[ "$(echo $output | tr -d '[:space:]')" != "Noserveconfig" ]]; then
    echo $output | head -n 1 | cut -d ' ' -f 1 | tr -d '[:space:]'
  fi
}
