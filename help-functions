#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

cmd-tailscale-help() {
  declare desc="help command"
  declare CMD="$1"
  local plugin_name="tailscale"
  local plugin_description="Run tailscale sidecar for an app"
  local plugin_description_long="$(cat <<desc
Run tailscale sidecar for an app

Store the Tailscale auth key (or OAuth client secret) on the host, readable
only by the dokku user. The key is read from stdin, never from arguments:

  ssh dokku@host tailscale:set-key < key.txt

Do not use dokku config:set --global TS_AUTHKEY: global config is visible to
every app. It is still read as a deprecated fallback.

If adding to an existing app, you will need to restart the app after running tailscale:up.
desc
)"

  if [[ "$CMD" == "${plugin_name}:help" ]]; then
    echo -e "Usage: dokku ${plugin_name}[:COMMAND]"
    echo ''
    echo "$plugin_description_long"
    echo ''
    echo 'Additional commands:'
    fn-help-content | sort | column -c2 -t -s,
  else
    cat <<help_desc
    $plugin_name, $plugin_description
help_desc
  fi
}

fn-help-content() {
  declare desc="return help content"
  cat <<help_content
    tailscale:up <app>, Starts the tailscale machine with the name of the app
    tailscale:down <app>, Stops the tailscale sidecar
    tailscale:serve <app> [<port>|stop], Starts or stops serving the provided port over https
    tailscale:set-key, Stores the auth key read from stdin (e.g. tailscale:set-key < key.txt)
    tailscale:key-status, Shows where the auth key comes from (never prints the key)
help_content
}
